using System;
using System.Collections.Generic;
using System.IO;
using System.Runtime.Serialization;
using System.Runtime.Serialization.Json;
using System.Security.Cryptography;
using System.Text;
namespace VixenRaster {
 [DataContract] public sealed class ObservationSpec {[DataMember] public string label,api;[DataMember] public int width,height;}
 [DataContract] public sealed class CaseSpec {[DataMember] public string id;[DataMember] public int width,height;[DataMember] public string[] events;[DataMember] public ObservationSpec[] observations;}
 [DataContract] public sealed class CaseSet {[DataMember] public int schema=1;[DataMember] public string byteOrder="ARGB8-row-major-top-down";[DataMember] public CaseSpec[] cases;}
 [DataContract] public sealed class FileRecord {[DataMember] public string path,sha256;[DataMember] public long bytes;}
 [DataContract] public sealed class Observation {[DataMember] public string label,api,pixelFormat,file;[DataMember] public int width,height,stride;}
 [DataContract] public sealed class DrawingDefaults {
  [DataMember] public string smoothing,pixelOffset,interpolation,compositingMode,compositingQuality,pageUnit;
  [DataMember] public float pageScale,dpiX,dpiY;[DataMember] public float[] transform,clipBounds,visibleClipBounds;[DataMember] public bool clipIsInfinite;
 }
 [DataContract] public sealed class DrawingState {[DataMember] public string label;[DataMember] public DrawingDefaults state;}
 [DataContract] public sealed class RasterReport {
  [DataMember] public int schema=1;[DataMember] public string status,id,byteOrder="ARGB8-row-major-top-down",hostSha256,originalMethodsSha256;
  [DataMember] public CaseSpec input;[DataMember] public string[] events;[DataMember] public Observation[] observations;[DataMember] public DrawingState[] drawingStates;[DataMember] public FileRecord[] files;
 }
 [DataContract] public sealed class RuntimeReport {
  [DataMember] public int schema=1;[DataMember] public string status,os,clr,hostSha256,drawingIdentity,drawingPath,drawingSha256,gdiplusPath,gdiplusVersion,gdiplusSha256;
  [DataMember] public bool is64BitProcess,is64BitOperatingSystem;[DataMember] public DrawingDefaults freshGraphicsDefaults;
 }
 public static class Data {
  public static string Hash(byte[] bytes){using(var sha=SHA256.Create())return BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-","").ToLowerInvariant();}
  public static string HashFile(string path){using(var file=File.OpenRead(path))using(var sha=SHA256.Create())return BitConverter.ToString(sha.ComputeHash(file)).Replace("-","").ToLowerInvariant();}
  public static byte[] Json(object value){using(var s=new MemoryStream()){new DataContractJsonSerializer(value.GetType()).WriteObject(s,value);return s.ToArray();}}
  public static void SaveNew(string path,object value){WriteNew(path,Json(value));}
  public static void WriteNew(string path,byte[] bytes){using(var f=new FileStream(path,FileMode.CreateNew,FileAccess.Write,FileShare.Read)){f.Write(bytes,0,bytes.Length);f.Flush();}}
  public static T Read<T>(string path,int limit){if(new FileInfo(path).Length>limit)throw new InvalidDataException("JSON limit");using(var f=File.OpenRead(path))return(T)new DataContractJsonSerializer(typeof(T)).ReadObject(f);}
  public static FileRecord Record(string dir,string name){string p=Path.Combine(dir,name);return new FileRecord{path=name,bytes=new FileInfo(p).Length,sha256=HashFile(p)};}
  public static CaseSet Cases(){using(var f=new MemoryStream(Convert.FromBase64String("")))return(CaseSet)new DataContractJsonSerializer(typeof(CaseSet)).ReadObject(f);}
  public static CaseSet ValidateCases(string path){var c=Read<CaseSet>(path,65536);if(Hash(Json(c))!=Hash(Json(Cases())))throw new InvalidDataException("Exact eight-case contract differs");return c;}
  public static byte[] Requested(CaseSpec c){
   int[][] seed={new[]{0,17,43,89},new[]{1,88,72,202},new[]{127,159,101,59},new[]{128,48,140,108},new[]{254,177,177,177},new[]{255,190,198,78}};
   byte[] b=new byte[c.width*c.height*4];int[] a={0,1,127,128,254,255};
   for(int y=0;y<c.height;y++)for(int x=0;x<c.width;x++){int n=(y*c.width+x)*4;if(c.width==6){for(int k=0;k<4;k++)b[n+k]=(byte)seed[x][k];}else{b[n]=(byte)a[(y*c.width+x)%6];b[n+1]=(byte)((71*x+31*y+17)%256);b[n+2]=(byte)((29*x+97*y+43)%256);b[n+3]=(byte)((113*x+19*y+89)%256);}}
   return b;
  }
  public static void ValidateReport(string dir,CaseSpec c,string host,string methods){
   var r=Read<RasterReport>(Path.Combine(dir,"manifest.json"),65536);
   if(r==null||r.schema!=1||r.status!="complete"||r.id!=c.id||r.byteOrder!="ARGB8-row-major-top-down"||Hash(Json(r.input))!=Hash(Json(c))||r.hostSha256!=host||r.originalMethodsSha256!=methods)throw new InvalidDataException("Case identity/provenance");
   if(r.events==null||Hash(Json(r.events))!=Hash(Json(c.events))||r.observations==null||r.observations.Length!=c.observations.Length)throw new InvalidDataException("Observer order/count");
   var expected=new HashSet<string>(StringComparer.Ordinal);expected.Add("input-requested.argb");
   for(int i=0;i<c.observations.Length;i++){
    var a=r.observations[i];var b=c.observations[i];string file=b.label+"-"+b.api+".argb";
    if(a==null||a.label!=b.label||a.api!=b.api||a.width!=b.width||a.height!=b.height||a.pixelFormat!="Format32bppArgb"||a.file!=file||(a.api=="getpixel"?a.stride!=0:Math.Abs(a.stride)!=a.width*4))throw new InvalidDataException("Observer schema/layout");expected.Add(file);
   }
   if(r.files==null||r.files.Length!=expected.Count)throw new InvalidDataException("Raw files missing");
   foreach(var f in r.files){if(f==null||!expected.Remove(f.path))throw new InvalidDataException("Duplicate/unexpected raw file");string p=Path.Combine(dir,f.path);long size=c.width*c.height*4;foreach(var o in r.observations)if(o.file==f.path)size=o.width*o.height*4;if(new FileInfo(p).Length!=size||f.bytes!=size||f.sha256!=HashFile(p))throw new InvalidDataException("Raw bytes/hash");}
   if(HashFile(Path.Combine(dir,"input-requested.argb"))!=Hash(Requested(c)))throw new InvalidDataException("Requested seed differs");
   if(r.drawingStates==null)throw new InvalidDataException("Drawing states missing");
   // Cross-API differences and changed seeded pixels remain evidence, not a tolerance or guessed result.
  }
 }
}
