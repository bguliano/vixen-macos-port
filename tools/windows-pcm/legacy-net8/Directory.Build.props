<Project><PropertyGroup><LegacyAuditRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</LegacyAuditRoot><BaseIntermediateOutputPath>$(LegacyAuditRoot)/target/windows-legacy-net8-local/obj/</BaseIntermediateOutputPath><MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath><OutputPath>$(LegacyAuditRoot)/target/windows-legacy-net8-local/bin/</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath></PropertyGroup></Project>
