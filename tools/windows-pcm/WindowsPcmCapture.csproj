    <UseAppHost>false</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="gdi-probe/**/*.cs;Supervisor.cs;v3-tests/**/*.cs" />
