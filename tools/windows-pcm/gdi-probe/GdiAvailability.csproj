<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><UseAppHost>false</UseAppHost>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../target/windows-gdi/obj/</BaseIntermediateOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)../../../target/windows-gdi/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Drawing" />
    <Compile Include="Program.cs" />
    <Compile Include="../../golden/media/GdiProbe.cs" Link="GdiProbe.cs" />
    <Reference Include="System.Drawing.Common"><HintPath>../../../target/golden/media/bin/System.Drawing.Common.dll</HintPath></Reference>
    <Reference Include="System.Private.Windows.Core"><HintPath>../../../target/golden/media/bin/System.Private.Windows.Core.dll</HintPath></Reference>
    <Reference Include="System.Private.Windows.GdiPlus"><HintPath>../../../target/golden/media/bin/System.Private.Windows.GdiPlus.dll</HintPath></Reference>
    <Reference Include="Microsoft.Win32.SystemEvents"><HintPath>../../../target/golden/media/bin/Microsoft.Win32.SystemEvents.dll</HintPath></Reference>
  </ItemGroup>
</Project>
