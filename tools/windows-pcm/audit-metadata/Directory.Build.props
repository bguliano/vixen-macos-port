<Project><PropertyGroup><AuditRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</AuditRoot><BaseIntermediateOutputPath>$(AuditRoot)/target/windows-metadata-audit/obj/</BaseIntermediateOutputPath><MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath><OutputPath>$(AuditRoot)/target/windows-metadata-audit/bin/</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath></PropertyGroup></Project>
