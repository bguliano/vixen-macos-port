using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.Runtime.Serialization;
using System.Text.RegularExpressions;
using VixenRaster;

namespace VixenCapture {
    [DataContract] public sealed class CaseOutcome {
        [DataMember] public string id,status,error,manifestSha256;
    }
    [DataContract] public sealed class Summary {
        [DataMember] public int schema=3;
        [DataMember] public string version="raster-detail-3",status="starting",results,compilerPath,compilerSha256,compilerVersion;
        [DataMember] public bool validWindowsRasterCaptured,comparisonPerformed=false;
        [DataMember] public int expectedCases=Data.Cases().cases.Length,completedCases;
        [DataMember] public List<StageResult> stages=new List<StageResult>();
        [DataMember] public List<string> notes=new List<string>();
        [DataMember] public List<CaseOutcome> cases=new List<CaseOutcome>();
    }
    public sealed class RasterWorkflow {
        readonly CaptureSupervisor supervisor;
        readonly string pack,output,compiler,powershell;
        public RasterWorkflow(string pack,string output,string compiler,string powershell,IStageLauncher launcher,double seconds) {
            this.pack=pack;this.output=output;this.compiler=compiler;this.powershell=powershell;
            supervisor=new CaptureSupervisor(output,launcher,seconds);
        }
        public Summary Report {get{return supervisor.Report;}}
        StageResult Run(string name,string executable,int seconds,params string[] args) {return supervisor.RunStage(new StageSpec{Name=name,Executable=executable,Arguments=args,Seconds=seconds});}
        static bool Complete(StageResult result) {return result.status=="completed" && result.exitCode==0;}
        public static void ValidateManifest(string directory,CaseSpec spec,string host,string methods,string countdown,string fastPixel) {
            var report=Data.Read<RasterReport>(Path.Combine(directory,"manifest.json"),65536);
            if(report==null || report.schema!=3 || report.status!="complete" || report.id!=spec.id || Data.Hash(Data.Json(report.input))!=Data.Hash(Data.Json(spec)) || report.byteOrder!="ARGB8-row-major-top-down") throw new InvalidDataException("Case identity/schema mismatch");
            if(report.outputWidth<1 || report.outputHeight<1 || report.outputWidth>64 || report.outputHeight>64 || report.inputStride!=spec.width*4 || report.outputStride!=report.outputWidth*4 || report.inputPixelFormat!="Format32bppArgb" || report.outputPixelFormat!="Format32bppArgb") throw new InvalidDataException("Dimensions/stride/format mismatch");
            if(report.outputWidth!=(spec.operation=="resize-exact"?spec.maxWidth:spec.width) || report.outputHeight!=(spec.operation=="resize-exact"?spec.maxHeight:spec.height))throw new InvalidDataException("Exact detail output dimensions mismatch");
            if(!report.inputUnchanged || !report.inputReadbacksEqual || !report.outputReadbacksEqual) throw new InvalidDataException("Input mutation or GDI/FastPixel readback discrepancy; raw evidence retained");
            if(report.hostSha256!=host || report.originalMethodsSha256!=methods || report.countDownMethodsSha256!=countdown || report.fastPixelSha256!=fastPixel || report.freshGraphicsDefaults==null) throw new InvalidDataException("Host/source/defaults provenance mismatch");
            if(spec.family=="picture" && spec.operation!="resize-exact") {
                if(report.actualDrawingDefaults!=null || report.drawingStateScope!="fresh-defaults-only-original-picture-body-uninstrumented")throw new InvalidDataException("Picture state provenance scope mismatch");
            } else {
                var state=report.actualDrawingDefaults;
                if(report.drawingStateScope!=(spec.operation=="resize-exact"?"actual-before-original-picture-drawimage-overload":"actual-before-identity-transform-fixture") || state==null || state.transform==null || state.transform.Length!=6 || state.clipBounds==null || state.clipBounds.Length!=4 || state.visibleClipBounds==null || state.visibleClipBounds.Length!=4)throw new InvalidDataException("Actual fixture Graphics state missing");
            }
            var names=new HashSet<string>(new[]{"input-requested.argb","input-getpixel.argb","input-fastpixel.argb","output-getpixel.argb","output-fastpixel.argb"},StringComparer.Ordinal);
            bool paths=spec.family=="primitive" && spec.operation=="ellipse";
            if(paths) {
                foreach(string label in new[]{"original","flat025","flat050","flat100"}) {
                    names.Add("path-"+label+"-getpixel.argb");names.Add("path-"+label+"-fastpixel.argb");
                }
                names.Add("path-trace.json");
            }
            if(report.files==null || report.files.Length!=names.Count) throw new InvalidDataException("Exact raw buffer/trace set missing");
            foreach(var file in report.files) {
                if(file==null || !names.Remove(file.path)) throw new InvalidDataException("Unexpected/duplicate raw file");
                string path=Paths.Local(Path.Combine(directory,file.path),true);
                long expected=file.path=="path-trace.json"?new FileInfo(path).Length:(file.path.StartsWith("input-")?spec.width*spec.height*4:report.outputWidth*report.outputHeight*4);
                if(file.path=="path-trace.json" && (expected<1 || expected>65536)) throw new InvalidDataException("Path trace byte limit");
                if(file.bytes!=expected || new FileInfo(path).Length!=expected || file.sha256!=Data.HashFile(path)) throw new InvalidDataException("Raw byte length/hash mismatch");
            }
            if(Data.HashFile(Path.Combine(directory,"input-requested.argb"))!=Data.Hash(Data.Requested(spec))) throw new InvalidDataException("Requested input differs from synthetic case");
            if(paths) {
                var trace=Data.Read<PathTraceReport>(Path.Combine(directory,"path-trace.json"),65536);
                string[] labels={"original","flat025","flat050","flat100"};float[] flatness={0,0.25f,0.5f,1};
                if(trace==null || trace.schema!=3 || trace.id!=spec.id || trace.paths==null || trace.paths.Length!=4)throw new InvalidDataException("Path trace identity/count mismatch");
                for(int n=0;n<4;n++) {
                    var item=trace.paths[n];
                    if(item==null || item.label!=labels[n] || item.flatness!=flatness[n] || item.points==null || item.types==null || item.pointBits==null || item.types.Length<4 || item.types.Length>2048 || item.points.Length!=item.types.Length*2 || item.pointBits.Length!=item.points.Length)throw new InvalidDataException("Malformed path trace");
                    if(item.drawingDefaults==null || item.drawingDefaults.transform==null || item.drawingDefaults.transform.Length!=6 || item.penColor!="FFFFFFFF" || item.penWidth!=1 || item.penStartCap==null || item.penEndCap==null || item.penLineJoin==null || item.penAlignment==null || item.fillMode==null)throw new InvalidDataException("Path drawing state missing");
                    for(int i=0;i<item.points.Length;i++)if(Single.IsNaN(item.points[i]) || Single.IsInfinity(item.points[i]) || BitConverter.ToInt32(BitConverter.GetBytes(item.points[i]),0)!=item.pointBits[i])throw new InvalidDataException("Path value/bits mismatch");
                    for(int i=0;i<item.types.Length;i++)if((item.types[i]&~(128|7))!=0 || (item.types[i]&7)>3)throw new InvalidDataException("Invalid GDI path type");
                    string prefix=Path.Combine(directory,"path-"+labels[n]);
                    if(Data.HashFile(prefix+"-getpixel.argb")!=Data.HashFile(prefix+"-fastpixel.argb"))throw new InvalidDataException("Path readback APIs disagree");
                }
            }
        }
        public int Run() {
            supervisor.Reserve(70);
            supervisor.Note("Raster-only verification: no Vixen install selection, PCM, profile, application launch or download.");
            Report.compilerPath=compiler;
            bool trusted=false,ready=false;string reason="pack-integrity-unavailable";
            string host=Path.Combine(output,"RasterCapture.exe");
            var integrity=Run("integrity",powershell,20,"-NoLogo","-NoProfile","-NonInteractive","-ExecutionPolicy","Bypass","-File",Path.Combine(pack,"Pack-Worker.ps1"),"-Stage","integrity","-Out",output);
            trusted=Complete(integrity);
            if(trusted) {
                try {
                    Data.ValidateCases(Path.Combine(pack,"cases.json"));
                    Report.compilerSha256=Data.HashFile(compiler);Report.compilerVersion=FileVersionInfo.GetVersionInfo(compiler).FileVersion;
                    var compiled=Run("compile-raster",compiler,30,"/nologo","/noconfig","/target:exe","/platform:anycpu","/langversion:5","/reference:System.dll","/reference:System.Core.dll","/reference:System.Xml.dll","/reference:System.Drawing.dll","/reference:System.Runtime.Serialization.dll","/out:"+host,Path.Combine(pack,"Shared.cs.in"),Path.Combine(pack,"OriginalPictureMethods.cs.in"),Path.Combine(pack,"OriginalCountDownMethods.cs.in"),Path.Combine(pack,"OriginalFastPixel.cs.in"),Path.Combine(pack,"RasterCapture.cs.in"));
                    reason="compile-failed";
                    if(Complete(compiled) && File.Exists(host) && new FileInfo(host).Length>0 && new FileInfo(host).Length<1048576) {
                        var probe=Run("preflight",host,15,"--preflight");reason="preflight-failed";
                        if(Complete(probe)) {
                            var metadata=Data.Read<RuntimeReport>(Path.Combine(output,"preflight.json"),65536);
                            ready=metadata.status=="available" && metadata.hostSha256==Data.HashFile(host) && Regex.IsMatch(metadata.gdiplusSha256??"","^[a-f0-9]{64}$") && Regex.IsMatch(metadata.drawingSha256??"","^[a-f0-9]{64}$");
                            if(!ready) reason="preflight-manifest-invalid";
                        }
                    }
                } catch(Exception error) {reason="dependency-error";supervisor.Note(error.GetType().Name+": "+error.Message);}
            }
            string hostHash=null,methodsHash=null,countdownHash=null,fastHash=null;
            var caseRoot=Path.Combine(output,"cases");
            if(ready) {
                try {
                    hostHash=Data.HashFile(host);methodsHash=Data.HashFile(Path.Combine(pack,"OriginalPictureMethods.cs.in"));countdownHash=Data.HashFile(Path.Combine(pack,"OriginalCountDownMethods.cs.in"));fastHash=Data.HashFile(Path.Combine(pack,"OriginalFastPixel.cs.in"));
                    Directory.CreateDirectory(caseRoot);
                } catch(Exception error) {ready=false;reason="capture-setup-error";supervisor.Note(error.GetType().Name+": "+error.Message);}
            }
            foreach(var spec in Data.Cases().cases) {
                var outcome=new CaseOutcome{id=spec.id,status="skipped-dependency",error=ready?null:reason};Report.cases.Add(outcome);
                if(ready) {
                    string directory=Path.Combine(caseRoot,spec.id);
                    try {
                        Directory.CreateDirectory(directory);
                        var capture=Run("case-"+spec.id,host,10,"--case",pack,spec.id);outcome.status=capture.status;
                        if(Complete(capture)) {
                            ValidateManifest(directory,spec,hostHash,methodsHash,countdownHash,fastHash);
                            outcome.status="captured";outcome.manifestSha256=Data.HashFile(Path.Combine(directory,"manifest.json"));Report.completedCases++;Report.validWindowsRasterCaptured=true;
                        }
                        else outcome.error="Stage "+capture.status+"; exit="+capture.exitCode+"; "+capture.error;
                    } catch(Exception error) {outcome.status="invalid-or-incomplete";outcome.error=error.GetType().Name+": "+error.Message;}
                }
                supervisor.Checkpoint();
            }
            var recheck=Run("integrity-final",powershell,20,"-NoLogo","-NoProfile","-NonInteractive","-ExecutionPolicy","Bypass","-File",Path.Combine(pack,"Pack-Worker.ps1"),"-Stage","integrity","-Out",output);
            Report.status=Report.completedCases==Data.Cases().cases.Length && Complete(recheck)?"captured-comparison-pending":"partial-or-diagnostics-only";
            supervisor.Checkpoint();
            // This finalized capture summary enters the ZIP. The later package
            // stage and changing bootstrap/progress logs remain in the folder.
            CaptureSupervisor.Save(Report,Path.Combine(output,"capture-summary.json"));
            supervisor.Reserve(0);
            var packaged=Run("package",powershell,60,"-NoLogo","-NoProfile","-NonInteractive","-ExecutionPolicy","Bypass","-File",Path.Combine(pack,"Pack-Worker.ps1"),"-Stage","package","-Out",output);
            bool zip=Complete(packaged) && File.Exists(output+".zip") && new FileInfo(output+".zip").Length>0;
            supervisor.Note(zip?"COPY THIS ZIP BACK: "+output+".zip":"COPY THIS ENTIRE FOLDER BACK: "+output);
            supervisor.Note("Capture success is not comparison success. Original drawing and Mac pixel parity remain distinct.");
            return zip && Report.status=="captured-comparison-pending"?0:2;
        }
    }
    public static class RasterEntry {
        public static int Main(string[] args) {
            if(args.Length!=3) {Console.Error.WriteLine("Expected pack, private results and existing Framework compiler");return 2;}
            string output=null;
            try {
                string pack=Paths.Local(args[0],true);output=Paths.Local(args[1],true);string compiler=Paths.Local(args[2],true);
                if(Path.GetDirectoryName(output)!=pack || !Path.GetFileName(output).StartsWith("results-")) throw new IOException("Private results must be a direct pack child");
                string windows=Environment.GetFolderPath(Environment.SpecialFolder.Windows);
                string c64=Path.Combine(windows,@"Microsoft.NET\Framework64\v4.0.30319\csc.exe"),c32=Path.Combine(windows,@"Microsoft.NET\Framework\v4.0.30319\csc.exe");
                if(!String.Equals(compiler,c64,StringComparison.OrdinalIgnoreCase) && !String.Equals(compiler,c32,StringComparison.OrdinalIgnoreCase)) throw new IOException("Only installed Framework compiler allowed");
                return new RasterWorkflow(pack,output,compiler,Path.Combine(windows,@"System32\WindowsPowerShell\v1.0\powershell.exe"),new WindowsLauncher(),660).Run();
            } catch(Exception error) {
                Console.Error.WriteLine(error);if(output!=null) {try{File.WriteAllText(Path.Combine(output,"supervisor-error.txt"),error.ToString());}catch{}}
                return 2;
            }
        }
    }
}
