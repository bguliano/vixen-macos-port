<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>VixenGolden</AssemblyName>
		<RootNamespace>VixenGolden</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<UseAppHost>false</UseAppHost>
		<InvariantGlobalization>true</InvariantGlobalization>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<NoWarn>$(NoWarn);CS1591;CA1416;NU1701</NoWarn>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<OutputPath>$(GoldenOut)/bin/</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<VixenNativeBin>/Users/developer/Documents/Codex/2026-09-13/is-the/outputs/Vixen/native/Vixen.Native.Tests/bin/Release/net10.0</VixenNativeBin>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="*.cs" Exclude="extras/**" />
		<Using Include="System.Drawing" />
        <Reference Include="NAudio.Core"><HintPath>$(GoldenOut)/helpers/lib/NAudio.Core.dll</HintPath><Private>true</Private></Reference>
		<!-- Compiled original Vixen, referenced read-only and copied into target/golden/bin. -->
		<Reference Include="Vixen.Core"><HintPath>$(VixenNativeBin)/Vixen.Core.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="Module.Effect.Native"><HintPath>$(VixenNativeBin)/Module.Effect.Native.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="Module.App.Native"><HintPath>$(VixenNativeBin)/Module.App.Native.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="Module.Property.Native"><HintPath>$(VixenNativeBin)/Module.Property.Native.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="Module.LayerMixingFilter.Native"><HintPath>$(VixenNativeBin)/Module.LayerMixingFilter.Native.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="Module.SequenceType.Native"><HintPath>$(VixenNativeBin)/Module.SequenceType.Native.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="Module.Timing.Native"><HintPath>$(VixenNativeBin)/Module.Timing.Native.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="Module.Media.Native"><HintPath>$(VixenNativeBin)/Module.Media.Native.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="NLog"><HintPath>$(VixenNativeBin)/NLog.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="Newtonsoft.Json"><HintPath>$(VixenNativeBin)/Newtonsoft.Json.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="Zstandard.Net"><HintPath>$(VixenNativeBin)/Zstandard.Net.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="System.Drawing.Common"><HintPath>$(VixenNativeBin)/System.Drawing.Common.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="System.Private.Windows.Core"><HintPath>$(VixenNativeBin)/System.Private.Windows.Core.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="System.Private.Windows.GdiPlus"><HintPath>$(VixenNativeBin)/System.Private.Windows.GdiPlus.dll</HintPath><Private>true</Private></Reference>
		<Reference Include="Microsoft.Win32.SystemEvents"><HintPath>$(VixenNativeBin)/Microsoft.Win32.SystemEvents.dll</HintPath><Private>true</Private></Reference>
	</ItemGroup>
</Project>
